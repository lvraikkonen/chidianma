DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunch_what
SESSION_SECRET=dev-session-secret-change-me
ALLOW_PUBLIC_GROUP_CREATION=true
LUCKY_RESTAURANT_WHEEL_ENABLED=false
LUCKY_RESTAURANT_WHEEL_GROUP_IDS=
# Restaurant onboarding gates are independent and require exact comma-separated group IDs.
# Manual import requires BULK; selected POI import requires SAVE; geocode/search require SEARCH.
# Mixed imports require both BULK and SAVE. No wildcard or default group is enabled.
RESTAURANT_BULK_IMPORT_ENABLED=false
RESTAURANT_BULK_IMPORT_GROUP_IDS=
POI_SEARCH_ENABLED=false
POI_SEARCH_GROUP_IDS=
POI_SAVE_ENABLED=false
POI_SAVE_GROUP_IDS=
POI_PROVIDER=mock
# Before enabling SEARCH or SAVE, set a random >=32-character secret different from SESSION_SECRET.
# POI_TICKET_SECRET=replace-with-an-independent-random-signing-secret
# Live Amap SEARCH also requires POI_PROVIDER=amap and a server-only Web Service key.
# AMAP_WEB_SERVICE_KEY=replace-with-your-amap-web-service-key
IDENTITY_TOKEN_TTL_DAYS=90
GROUP_SESSION_TTL_DAYS=14
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
OFFICE_CITY=Shanghai
OFFICE_LATITUDE=31.2304
OFFICE_LONGITUDE=121.4737
OFFICE_TIMEZONE=Asia/Shanghai
PUBLIC_API_BASE_URL=http://localhost:3000
NODE_ENV=development
